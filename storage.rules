rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Existing photo uploads (working)
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /photos-thumbs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // NEW: Gallery uploads (wildlife / birds / landscapes / portraits / others)
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
