rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photo uploads
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /photos-thumbs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery uploads (wildlife / birds / landscapes / portraits / others)
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Story cover image uploads
    match /story-covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Inline images inside story content
    match /stories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site Settings: hero slider, category images, default thumbnail
    match /site-settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
