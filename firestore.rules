rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Photos collection (existing — keeps working uploads functional)
    match /photos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // NEW: Gallery photos collection
    match /galleryPhotos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Other collections used in the app
    match /stories/{docId}        { allow read: if true; allow write: if request.auth != null; }
    match /videos/{docId}         { allow read: if true; allow write: if request.auth != null; }
    match /comments/{docId}       { allow read: if true; allow create: if true; allow update, delete: if request.auth != null; }

    // Public contact form writes to contactMessages; admins can read/delete them.
    match /contactMessages/{docId} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /contacts/{docId}        { allow create: if true; allow read, update, delete: if request.auth != null; }

    // Client settings documents live in the shared settings collection.
    match /settings/{docId}       { allow read: if true; allow write: if request.auth != null; }
    match /siteSettings/{docId}   { allow read: if true; allow write: if request.auth != null; }
    match /aiSettings/{docId}     { allow read: if true; allow write: if request.auth != null; }

    match /user_likes/{docId}     { allow read: if true; allow write: if request.auth != null; }
    match /userLikes/{docId}      { allow read: if true; allow write: if request.auth != null; }
    match /visitors/{docId}       { allow read: if true; allow create, update: if true; allow delete: if request.auth != null; }
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null;
    }

    match /community_posts/{docId}   { allow read: if true; allow write: if request.auth != null; }
    match /community_members/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /self_ads/{docId}          { allow read: if true; allow write: if request.auth != null; }

    // ✅ FIX: online_visitors — everyone can read/write (tracks anonymous + logged-in presence)
    match /online_visitors/{docId} { allow read, write: if true; }

    // Analytics tracking — anonymous visitors can create/update their session stats,
    // admin/authenticated users can read dashboards.
    match /visitor_events/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /visitor_daily_stats/{docId} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }
    match /page_views/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /shares/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
