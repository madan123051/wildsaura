rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Photos collection (existing — keeps working uploads functional)
    match /photos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // NEW: Gallery photos collection
    match /galleryPhotos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Other collections used in the app
    match /stories/{docId}        { allow read: if true; allow write: if request.auth != null; }
    match /videos/{docId}         { allow read: if true; allow write: if request.auth != null; }
    match /comments/{docId}       { allow read: if true; allow write: if request.auth != null; }
    match /contacts/{docId}       { allow read: if true; allow write: if request.auth != null; }
    match /siteSettings/{docId}   { allow read: if true; allow write: if request.auth != null; }
    match /aiSettings/{docId}     { allow read: if true; allow write: if request.auth != null; }
    match /userLikes/{docId}      { allow read: if true; allow write: if request.auth != null; }
    match /visitors/{docId}       { allow read: if true; allow write: if request.auth != null; }
  }
}
