{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/static-page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/og-photo.js": {
      "includeFiles": "dist/index.html"
    },
    "api/og-story.js": {
      "includeFiles": "dist/index.html"
    },
    "api/og-category.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/static-page?slug=home"
    },
    {
      "source": "/photos",
      "destination": "/api/static-page?slug=photos"
    },
    {
      "source": "/photo-grid",
      "destination": "/api/static-page?slug=photo-grid"
    },
    {
      "source": "/story-grid",
      "destination": "/api/static-page?slug=story-grid"
    },
    {
      "source": "/community",
      "destination": "/api/static-page?slug=community"
    },
    {
      "source": "/about",
      "destination": "/api/static-page?slug=about"
    },
    {
      "source": "/contact",
      "destination": "/api/static-page?slug=contact"
    },
    {
      "source": "/terms",
      "destination": "/api/static-page?slug=terms"
    },
    {
      "source": "/marketplace",
      "destination": "/api/static-page?slug=marketplace"
    },
    {
      "source": "/ngo",
      "destination": "/api/static-page?slug=ngo"
    },
    {
      "source": "/video-grid",
      "destination": "/api/static-page?slug=video-grid"
    },
    {
      "source": "/photo/:id",
      "destination": "/api/og-photo?id=:id"
    },
    {
      "source": "/story/:slug",
      "destination": "/api/og-story?slug=:slug"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/og-category?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
