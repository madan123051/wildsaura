# Client-visible Firebase web config. These are bundled into the browser app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Firebase Console > Realtime Database > database URL (rebuild after changing).
VITE_FIREBASE_DATABASE_URL=
# Match Firebase Console > App Check > Apps. PUBLIC site key, never a secret key.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Set exactly recaptcha-v3 or recaptcha-enterprise, matching your registration.
VITE_FIREBASE_APPCHECK_PROVIDER=
VITE_GOOGLE_MAPS_API_KEY=
VITE_ADMIN_EMAIL=

# Server-only Vercel function config. Do not prefix these with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_CONTROL_CENTER_URL=
WEBSITE_CONNECTOR_SECRET=
